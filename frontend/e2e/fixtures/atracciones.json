ince":"Azuay","region":"SIERRA"},"photos":[{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/cuenca.jpg","alt":"Cuenca colonial y taller de sombreros de paja toquilla – foto 1"}],"supported_languages":["es","en"],"free_cancellation":true,"cancellation_hours":24,"times":["09:00","14:30"],"capacity_per_slot":20,"meeting_point":"Parque Calderón, frente a la Catedral Nueva","featured":true,"is_active":true,"status":"PUBLICADA","ratings":{"number_of_reviews":5,"score":4.8},"url":{"web":"https://descubre-ec.vercel.app/atraccion/20c52405-22a1-4919-a2ec-38531768e505","app":"descubreec://attractions/20c52405-22a1-4919-a2ec-38531768e505"},"_links":{"self":{"href":"/api/v1/atracciones/20c52405-22a1-4919-a2ec-38531768e505","method":"GET"},"availability":{"href":"/api/v1/atracciones/20c52405-22a1-4919-a2ec-38531768e505/availability","method":"GET"},"reviews":{"href":"/api/v1/atracciones/20c52405-22a1-4919-a2ec-38531768e505/reviews","method":"GET"},"reserve":{"href":"/api/v1/atracciones/20c52405-22a1-4919-a2ec-38531768e505/reservations","method":"POST"},"update":{"href":"/api/v1/atracciones/20c52405-22a1-4919-a2ec-38531768e505","method":"PATCH"},"delete":{"href":"/api/v1/atracciones/20c52405-22a1-4919-a2ec-38531768e505","method":"DELETE"}}},{"id":"a2c575b0-9a46-4fd8-a81a-1c25683af025","name":"Parque Nacional Cotopaxi y Laguna de Limpiopungo","slug":"parque-nacional-cotopaxi-y-laguna-de-limpiopungo","short_description":"Sube hasta los 4.500 m en el volcán activo más famoso del Ecuador y camina entre páramos y caballos salvajes.","long_description":"Salimos temprano desde Quito por la Avenida de los Volcanes hasta el Parque Nacional Cotopaxi. Recorremos la laguna de Limpiopungo, donde es común ver venados de cola blanca y curiquingues, y luego subimos en vehículo hasta el parqueadero a 4.500 m.\n\nDesde ahí, quien se anime camina hasta el refugio José Rivas (4.864 m) con vistas al glaciar. El regreso incluye almuerzo típico en una hacienda andina con locro de papa y canelazo.","duration":"PT10H","duration_hours":10,"price":{"currency":"USD","total":65},"child_price":{"currency":"USD","total":45},"operator":{"id":101,"name":"Andes Explorer Ecuador"},"product_type":"GUIDED_TOUR","includes":["Transporte ida y vuelta desde Quito","Guía naturalista bilingüe","Entrada al parque","Almuerzo típico","Bastones de caminata"],"not_includes":["Propinas","Bebidas adicionales"],"recommendations":["Ropa abrigada e impermeable","Protector solar y gafas","Zapatos cómodos de caminata","Aclimatarse al menos un día en Quito"],"categories":["naturales","aventura","montana"],"badges":[],"locations":[{"address":"Parque Nacional Cotopaxi, control Caspi","city":13,"country":"ec","coordinates":{"latitude":-0.6806,"longitude":-78.4378},"type":"attraction"}],"destination":{"code":13,"name":"Latacunga","province":"Cotopaxi","region":"SIERRA"},"photos":[{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/cotopaxi.jpg","alt":"Parque Nacional Cotopaxi y Laguna de Limpiopungo – foto 1"},{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/cotopaxi-2.jpg","alt":"Parque Nacional Cotopaxi y Laguna de Limpiopungo – foto 2"}],"supported_languages":["es","en"],"free_cancellation":true,"cancellation_hours":24,"times":["06:30"],"capacity_per_slot":16,"meeting_point":"Parque La Carolina, frente al C.C. Quicentro (Quito)","featured":true,"is_active":true,"status":"PUBLICADA","ratings":{"number_of_reviews":2,"score":5},"url":{"web":"https://descubre-ec.vercel.app/atraccion/a2c575b0-9a46-4fd8-a81a-1c25683af025","app":"descubreec://attractions/a2c575b0-9a46-4fd8-a81a-1c25683af025"},"_links":{"self":{"href":"/api/v1/atracciones/a2c575b0-9a46-4fd8-a81a-1c25683af025","method":"GET"},"availability":{"href":"/api/v1/atracciones/a2c575b0-9a46-4fd8-a81a-1c25683af025/availability","method":"GET"},"reviews":{"href":"/api/v1/atracciones/a2c575b0-9a46-4fd8-a81a-1c25683af025/reviews","method":"GET"},"reserve":{"href":"/api/v1/at