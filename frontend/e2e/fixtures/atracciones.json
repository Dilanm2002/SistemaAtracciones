{"data":[{"id":"18fc67dd-b014-4e45-ba03-375a53cafcd6","name":"Ciudad Mitad del Mundo y Museo Intiñan","slug":"ciudad-mitad-del-mundo-y-museo-intinan","short_description":"Párate con un pie en cada hemisferio y descubre los experimentos del museo solar Intiñan.","long_description":"Visita el monumento de 30 metros que marca la latitud 0° 0' 0\" y el museo etnográfico en su interior. Después cruzamos al Museo Intiñan, donde la línea ecuatorial calculada por GPS permite experimentos sorprendentes: equilibrar un huevo sobre un clavo o ver el efecto Coriolis en el agua.\n\nTerminamos con tiempo libre en la plaza para probar helados de paila y comprar artesanías.","duration":"PT4H","duration_hours":4,"price":{"currency":"USD","total":25},"child_price":{"currency":"USD","total":15},"operator":{"id":103,"name":"Quito Tour Bus"},"product_type":"GUIDED_TOUR","includes":["Transporte","Entradas al monumento y al Museo Intiñan","Guía"],"not_includes":["Alimentación"],"recommendations":["Gorra y protector solar: el sol ecuatorial es intenso"],"categories":["cultural","tours-ciudad"],"badges":[],"locations":[{"address":"Av. Manuel Córdova Galarza, San Antonio de Pichincha","city":3,"country":"ec","coordinates":{"latitude":-0.0022,"longitude":-78.4558},"type":"attraction"}],"destination":{"code":3,"name":"Quito","province":"Pichincha","region":"SIERRA"},"photos":[{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/mitad-mundo.jpg","alt":"Ciudad Mitad del Mundo y Museo Intiñan – foto 1"},{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/mitad-mundo-2.jpg","alt":"Ciudad Mitad del Mundo y Museo Intiñan – foto 2"}],"supported_languages":["es","en","fr"],"free_cancellation":true,"cancellation_hours":24,"times":["09:00","14:00"],"capacity_per_slot":25,"meeting_point":"Plaza Grande, Centro Histórico de Quito","featured":true,"is_active":true,"status":"PUBLICADA","ratings":{"number_of_reviews":3,"score":4},"url":{"web":"https://descubre-ec.