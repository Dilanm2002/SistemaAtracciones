ión amazónica 4 días – foto 2"}],"supported_languages":["es","en"],"free_cancellation":true,"cancellation_hours":72,"times":["08:00"],"capacity_per_slot":12,"meeting_point":"Terminal de Lago Agrio (traslado incluido)","featured":true,"is_active":true,"status":"PUBLICADA","ratings":{"number_of_reviews":5,"score":4.8},"url":{"web":"https://descubre-ec.vercel.app/atraccion/55884089-db9c-497d-b13f-fd9647b37d33","app":"descubreec://attractions/55884089-db9c-497d-b13f-fd9647b37d33"},"_links":{"self":{"href":"/api/v1/atracciones/55884089-db9c-497d-b13f-fd9647b37d33","method":"GET"},"availability":{"href":"/api/v1/atracciones/55884089-db9c-497d-b13f-fd9647b37d33/availability","method":"GET"},"reviews":{"href":"/api/v1/atracciones/55884089-db9c-497d-b13f-fd9647b37d33/reviews","method":"GET"},"reserve":{"href":"/api/v1/atracciones/55884089-db9c-497d-b13f-fd9647b37d33/reservations","method":"POST"},"update":{"href":"/api/v1/atracciones/55884089-db9c-497d-b13f-fd9647b37d33","method":"PATCH"},"delete":{"href":"/api/v1/atracciones/55884089-db9c-497d-b13f-fd9647b37d33","method":"DELETE"}}},{"id":"58da47b1-1d9f-4088-a3ec-52e61f8fe9c3","name":"Ruta de las Cascadas y Pailón del Diablo","slug":"ruta-de-las-cascadas-y-pailon-del-diablo","short_description":"Recorre en chiva la ruta Baños–Río Verde y camina hasta la cascada más impresionante del país.","long_description":"Viajamos en chiva por la ruta de las cascadas: Agoyán, Manto de la Novia (con tarabita opcional) y finalmente el Pailón del Diablo, donde un sendero entre helechos te deja literalmente detrás de la caída de agua.\n\nPrepárate para mojarte: la fuerza del agua se siente en todo el cuerpo.","duration":"PT5H","duration_hours":5,"price":{"currency":"USD","total":30},"child_price":{"currency":"USD","total":20},"operator":{"id":101,"name":"Andes Explorer Ecuador"},"product_type":"GUIDED_TOUR","includes":["Transporte en chiva","Guía","Entrada al Pailón del Diablo"],"not_includes":["Tarabita ($2)","Canopy ($15)"],"recommendatio