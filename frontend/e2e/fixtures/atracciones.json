ápagos.","long_description":"Navegamos desde Puerto Baquerizo Moreno hasta el León Dormido, dos rocas volcánicas de 150 m que emergen del océano. En su canal hacemos snorkel con tortugas verdes, rayas águila, lobos marinos y, con suerte, tiburones martillo y de Galápagos.\n\nPor la tarde paramos en una playa de Isla San Cristóbal para descansar y almorzar a bordo.","duration":"PT8H","duration_hours":8,"price":{"currency":"USD","total":165},"child_price":{"currency":"USD","total":140},"operator":{"id":102,"name":"Galápagos Blue Tours"},"product_type":"GUIDED_TOUR","includes":["Lancha","Equipo de snorkel y traje de neopreno","Almuerzo a bordo","Guía naturalista"],"not_includes":["Propinas"],"recommendations":["Pastilla para el mareo","Saber nadar es obligatorio"],"categories":["aventura","vida-silvestre","playas"],"badges":[],"locations":[{"address":"Isla San Cristóbal, Galápagos","city":7,"country":"ec","coordinates":{"latitude":-0.7806,"longitude":-89.5156},"type":"attraction"}],"destination":{"code":7,"name":"Puerto Baquerizo Moreno","province":"Galápagos","region":"GALAPAGOS"},"photos":[{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/kicker-rock.jpg","alt":"Snorkel en el León Dormido (Kicker Rock) – foto 1"},{"url":"https://sistemaatracciones-backend.vercel.app/api/v1/media/catalogo/kicker-rock-2.jpg","alt":"Snorkel en el León Dormido (Kicker Rock) – foto 2"}],"supported_languages":["es","en"],"free_cancellation":true,"cancellation_hours":48,"times":["07:30"],"capacity_per_slot":16,"meeting_point":"Muelle turístico de Puerto Baquerizo Moreno","featured":true,"is_active":true,"status":"PUBLICADA","ratings":{"number_of_reviews":5,"score":4.8},"url":{"web":"https://descubre-ec.vercel.app/atraccion/4fcd5948-9325-4833-9eae-feaafe9c0e41","app":"descubreec://attractions/4fcd5948-9325-4833-9eae-feaafe9c0e41"},"_links":{"self":{"href":"/api/v1/atracciones/4fcd5948-9325-4833-9eae-feaafe9c0e41","method":"GET"},"availability":{"href":"/api/v1/atrac