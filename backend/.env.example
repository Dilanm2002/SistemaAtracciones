# Puerto del contenedor de PostgreSQL en tu máquina (ver docker-compose.yml)
DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_db?schema=public"
NODE_ENV=development
PORT=3000

# URL pública de esta API (para construir URLs absolutas de fotos)
PUBLIC_URL=http://localhost:3000
# URL del frontend (CORS y enlaces url.web del contrato). Varias separadas por coma.
FRONTEND_URL=http://localhost:5173

# Firma de los JWT. CAMBIAR en producción.
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=8h

# Carga datos de demostración si la base está vacía
SEED_ON_START=true

# ── Producción (Supabase + Vercel) ───────────────────────────────────────
# DATABASE_URL: usar el "Transaction pooler" de Supabase (puerto 6543)
# DB_SSL=true
# DB_SYNC=false            # true solo la primera vez para crear las tablas
# DB_POOL_MAX=3
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<clave service_role, NUNCA en el frontend>
# SUPABASE_BUCKET=uploads
