# Puerto del contenedor de PostgreSQL en tu máquina (ver docker-compose.yml)
DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking_db?schema=public"
NODE_ENV=development
PORT=3000
# 0.0.0.0 = acepta conexiones de otras máquinas (prueba con Booking por Tailscale). 127.0.0.1 = solo esta máquina.
HOST=0.0.0.0

# ── Integración con Booking Prototipo (docs/INTEGRACION-BOOKING-V2.md §7) ──
# Clave que Booking envía en X-API-Key (mínimo 24 caracteres). Genérala y compártela con Booking por un canal privado.
# BOOKING_API_KEY=
# Destino gRPC del stock. Nube: rda1-backend-integracion-sistemas.onrender.com:50051 · prueba local: <IP Tailscale de Booking>:50051
# BOOKING_GRPC_URL=
# BOOKING_GRPC_ENABLED=true
# Código de nodo con el que te registraron en el panel de Booking (ej. NODE_ATR_DILAN)
BOOKING_SERVICE_ID=NODE_ATR_DILAN

# URL pública de esta API (para construir URLs absolutas de fotos)
PUBLIC_URL=http://localhost:3000
# URL del frontend (CORS y enlaces url.web del contrato). Varias separadas por coma.
FRONTEND_URL=http://localhost:5173

# Firma de los JWT: mínimo 32 caracteres aleatorios. La API NO arranca con un valor de ejemplo.
JWT_SECRET=cambia-este-secreto  (genera uno: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_EXPIRES_IN=2h

# Carga datos de demostración si la base está vacía (SOLO desarrollo).
# En producción debe ser false: si no, la API no arranca (V2-SEG-01).
SEED_ON_START=true

# Swagger (/api/docs) y Redoc (/api/redoc): en producción solo con ENABLE_DOCS=true (SEG-019)
# ENABLE_DOCS=true

# ── Producción (Supabase + Vercel) ───────────────────────────────────────
# DATABASE_URL: usar el "Transaction pooler" de Supabase (puerto 6543)
# DB_SSL=true
# SEED_ON_START=false      # obligatorio en producción
# DB_SYNC=false            # prohibido en producción (el esquema lo crean las migraciones)
# DB_POOL_MAX=3
# SUPABASE_URL=https://<proyecto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<clave service_role, NUNCA en el frontend>
# SUPABASE_BUCKET=uploads
# Proxy inverso delante de la API (para la IP real del límite de peticiones).
# Vacío: se confía en X-Forwarded-For solo en Vercel. Ej.: TRUST_PROXY=1 detrás de nginx.
TRUST_PROXY=
