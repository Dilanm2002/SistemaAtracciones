{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "gru1"
  ],
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "contracts/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/docs/:archivo(swagger-ui\\.css|swagger-ui-bundle\\.js|swagger-ui-standalone-preset\\.js|favicon-32x32\\.png|favicon-16x16\\.png)",
      "destination": "/vendor/swagger-ui/:archivo"
    },
    {
      "source": "/((?!img/|uploads/|vendor/).*)",
      "destination": "/api"
    }
  ]
}
