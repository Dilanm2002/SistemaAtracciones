{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "contracts/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!img/|uploads/).*)",
      "destination": "/api"
    }
  ]
}
