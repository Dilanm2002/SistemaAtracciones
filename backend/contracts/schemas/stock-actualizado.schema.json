{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sistemaatracciones-backend.vercel.app/contracts/schemas/stock-actualizado.schema.json",
  "title": "atracciones.stock.actualizado",
  "description": "Esquema canonico del proceso Inventario/Stock. La raiz valida el evento de dominio (CloudEvents 1.0 + sobre de outbox). En $defs estan las representaciones JSON de los mensajes gRPC (proto con keepCase) y del snapshot de lectura, para validar payloads y pruebas de contrato. Fuente: docs/CONTRATO-SCHEMA-FIRST.md.",
  "$ref": "#/$defs/StockEvent",
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid",
      "description": "UUID v4.",
      "examples": [
        "123e4567-e89b-12d3-a456-426614174000"
      ]
    },
    "SlotId": {
      "type": "string",
      "pattern": "^slot-[0-9]{8}-[0-9]{4}$",
      "description": "Clave canonica del turno: slot-AAAAMMDD-HHMM. Si esta presente, prevalece sobre date + time_slot.",
      "examples": [
        "slot-20261025-1030"
      ]
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Fecha local del turno en formato YYYY-MM-DD.",
      "examples": [
        "2026-10-25"
      ]
    },
    "Time24h": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "Hora canonica local en formato HH:mm (24 h). Es la que se usa para calculos y como clave.",
      "examples": [
        "10:30",
        "00:05"
      ]
    },
    "Time12h": {
      "type": "string",
      "pattern": "^(0[1-9]|1[0-2]):[0-5][0-9] (a\\.m\\.|p\\.m\\.)$",
      "description": "Hora de presentacion acordada con Booking. Solo para mostrar; nunca para calculos.",
      "examples": [
        "10:30 a.m.",
        "02:00 p.m."
      ]
    },
    "Timezone": {
      "type": "string",
      "pattern": "^[A-Za-z]+(?:/[A-Za-z0-9_+-]+)+$",
      "description": "Zona horaria IANA. Mientras no se acuerde otra, America/Guayaquil.",
      "examples": [
        "America/Guayaquil"
      ]
    },
    "StockReason": {
      "type": "string",
      "description": "Motivo del cambio de cupo. No se usa para reconstruir el estado: el valor absoluto manda.",
      "enum": [
        "VENTA",
        "CANCELACION",
        "CHECKIN",
        "AFORO"
      ]
    },
    "StockErrorCode": {
      "type": "string",
      "description": "Codigo estable de error del contrato. El campo message es solo para humanos y nunca se parsea.",
      "enum": [
        "STOCK_ERROR_CODE_UNSPECIFIED",
        "OK",
        "INVALID_ARGUMENT",
        "UNAUTHENTICATED",
        "PERMISSION_DENIED",
        "NOT_FOUND",
        "STALE_REVISION",
        "CONFLICT",
        "RATE_LIMITED",
        "UNAVAILABLE",
        "INTERNAL"
      ],
      "$comment": "En gRPC, @grpc/proto-loader devuelve el enum como numero salvo que se configure enums: 'String'. Ajustar el validador del cliente o mapear el valor numerico."
    },
    "StockEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "attraction_id",
        "date",
        "time_24h",
        "time",
        "timezone",
        "total_units",
        "available_units",
        "revision",
        "reason"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/SlotId"
        },
        "attraction_id": {
          "$ref": "#/$defs/Uuid"
        },
        "date": {
          "$ref": "#/$defs/IsoDate"
        },
        "time_24h": {
          "$ref": "#/$defs/Time24h"
        },
        "time": {
          "$ref": "#/$defs/Time12h"
        },
        "timezone": {
          "$ref": "#/$defs/Timezone"
        },
        "total_units": {
          "type": "integer",
          "minimum": 0,
          "description": "Capacidad del turno."
        },
        "available_units": {
          "type": "integer",
          "minimum": 0,
          "description": "Cupos libres. Las retenciones pendientes ya estan descontadas."
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Version monotona por slot_id. El consumidor descarta revisiones menores."
        },
        "reason": {
          "$ref": "#/$defs/StockReason"
        }
      },
      "$comment": "Invariante de negocio no expresable en JSON Schema: 0 <= available_units <= total_units. Validar en dominio o con Ajv $data."
    },
    "StockEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "specversion",
        "id",
        "source",
        "type",
        "time",
        "sequence_number",
        "correlation_id",
        "data"
      ],
      "properties": {
        "specversion": {
          "const": "1.0"
        },
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "source": {
          "type": "string",
          "pattern": "^/api/v[0-9]+/atracciones$",
          "description": "Origen del evento (CloudEvents source)."
        },
        "type": {
          "const": "STOCK_ACTUALIZADO"
        },
        "time": {
          "type": "string",
          "format": "date-time",
          "description": "Instante del evento en ISO 8601 UTC."
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0,
          "description": "Orden monotono por slot_id. Detecta huecos y descarta eventos viejos."
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "ID de correlacion de la peticion original."
        },
        "data": {
          "$ref": "#/$defs/StockEventData"
        }
      },
      "examples": [
        {
          "specversion": "1.0",
          "id": "9b2f1c4e-7a3d-4f6b-8c1e-2d5a7f9b0c3e",
          "source": "/api/v2/atracciones",
          "type": "STOCK_ACTUALIZADO",
          "time": "2026-10-25T15:30:00Z",
          "sequence_number": 1532,
          "correlation_id": "cid-prueba-001",
          "data": {
            "slot_id": "slot-20261025-1030",
            "attraction_id": "123e4567-e89b-12d3-a456-426614174000",
            "date": "2026-10-25",
            "time_24h": "10:30",
            "time": "10:30 a.m.",
            "timezone": "America/Guayaquil",
            "total_units": 20,
            "available_units": 17,
            "revision": 42,
            "reason": "VENTA"
          }
        }
      ]
    },
    "StockUpdateMessage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Representacion JSON de inventory.StockUpdateMessage (keepCase). Valida el payload antes de invocar PushStockUpdate.",
      "required": [
        "service_id",
        "item_id",
        "date",
        "time_slot",
        "available_units",
        "timestamp",
        "slot_id",
        "revision",
        "total_units",
        "timezone",
        "idempotency_key",
        "time_24h"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Tienda o nodo dueno del cupo, p. ej. atracciones-dilan."
        },
        "item_id": {
          "$ref": "#/$defs/Uuid"
        },
        "date": {
          "$ref": "#/$defs/IsoDate"
        },
        "time_slot": {
          "$ref": "#/$defs/Time12h"
        },
        "available_units": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch en milisegundos UTC, hora del evento (no la del envio)."
        },
        "slot_id": {
          "$ref": "#/$defs/SlotId"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "total_units": {
          "type": "integer",
          "minimum": 0
        },
        "timezone": {
          "$ref": "#/$defs/Timezone"
        },
        "idempotency_key": {
          "$ref": "#/$defs/Uuid"
        },
        "time_24h": {
          "$ref": "#/$defs/Time24h"
        }
      },
      "$comment": "date y time_slot se conservan por compatibilidad; slot_id + time_24h son la clave canonica. Invariante: available_units <= total_units."
    },
    "StockUpdateAck": {
      "type": "object",
      "additionalProperties": false,
      "description": "Representacion JSON de inventory.StockUpdateAck. La decision de reintento se toma con code y retryable, nunca con message.",
      "required": [
        "success",
        "processed_at",
        "code",
        "retryable",
        "slot_id",
        "revision"
      ],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 300,
          "description": "Texto para humanos y logs."
        },
        "processed_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch en milisegundos UTC."
        },
        "code": {
          "$ref": "#/$defs/StockErrorCode"
        },
        "retryable": {
          "type": "boolean"
        },
        "slot_id": {
          "$ref": "#/$defs/SlotId"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Revision aceptada por el servidor. Si es menor que la enviada, el resultado es STALE_REVISION."
        }
      }
    },
    "StockSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Estado de un turno para reconciliacion (GetStock / GetStockBatch). En REST se expone con los alias attraction_id, time, capacidad y disponibles.",
      "required": [
        "slot_id",
        "item_id",
        "date",
        "time_slot",
        "timezone",
        "total_units",
        "available_units",
        "revision",
        "updated_at"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/SlotId"
        },
        "item_id": {
          "$ref": "#/$defs/Uuid"
        },
        "date": {
          "$ref": "#/$defs/IsoDate"
        },
        "time_slot": {
          "$ref": "#/$defs/Time12h"
        },
        "time_24h": {
          "$ref": "#/$defs/Time24h"
        },
        "timezone": {
          "$ref": "#/$defs/Timezone"
        },
        "total_units": {
          "type": "integer",
          "minimum": 0
        },
        "available_units": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updated_at": {
          "type": "integer",
          "minimum": 0,
          "description": "Epoch en milisegundos UTC de la ultima actualizacion."
        }
      }
    }
  }
}
