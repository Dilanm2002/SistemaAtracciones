# Copia este archivo como deploy/azure/.env y llénalo. Ese .env NO se sube a git.
# Los valores de Supabase son los MISMOS que tiene hoy la tienda en Vercel
# (Vercel → proyecto → Settings → Environment Variables).

# ── Azure ────────────────────────────────────────────────────────────────
AZ_GRUPO=rg-descubre-ec
# Región permitida por tu suscripción. Azure for Students (PUCE): westus2, spaincentral, chilecentral, canadacentral, northcentralus
AZ_REGION=chilecentral
# Nombre del registro de imágenes: único en todo Azure, solo minúsculas y números (5–50)
AZ_REGISTRO=descubreecdilan

# true (por defecto): solo se publican ms_location, ms_catalog, ms_review y el gateway. Las rutas de los
# compañeros (disponibilidad, reservas, promociones…) responden 503 SERVICIO_NO_CONECTADO hasta conectar
# sus microservicios. false: también se publica la tienda (monolito) y atiende todo el contrato.
SIN_TIENDA=true

# ── Base de datos (Supabase) ─────────────────────────────────────────────
# La de la tienda en Vercel ("Transaction pooler", puerto 6543). Los microservicios usan la misma
# base con su propio schema (ms_location, ms_catalog, ms_review) por el "Session pooler" (5432),
# que el script deriva de esta URL.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# ── Tienda ───────────────────────────────────────────────────────────────
# El mismo JWT_SECRET de Vercel: así las sesiones y tokens de admin sirven en las dos.
JWT_SECRET=
# URL del frontend en Vercel (CORS y enlaces de los vouchers)
FRONTEND_URL=

# ── Booking ──────────────────────────────────────────────────────────────
# La clave que Booking envía en X-API-Key (la misma que ya tiene Paúl)
BOOKING_API_KEY=
BOOKING_SERVICE_ID=NODE_ATR_DILAN
# gRPC de Booking en la nube (host:puerto que indique Paúl). Vacío = no se envía el stock.
BOOKING_GRPC_URL=
